{
  "manifest_version": 3,
  "name": "PhishGuard - Gmail Phishing Flag",
  "version": "0.1.0",
  "description": "Flags suspicious emails in Gmail UI using PhishGuard backend.",
  "permissions": ["storage", "loopback"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

